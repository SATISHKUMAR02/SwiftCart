{
  "Routes": [
    // ================================================================================== ORDERS MICROSERICE
    { //GET ORDERS
      "UpstreamPathTemplate": "/gateway/Orders",
      "DownstreamPathTemplate": "/api/Orders/GetOrders",

      "DownstreamHostAndPorts": [
        {
          "Host": "ordersmicroservice.api",
          "Port": 8080
        },

        // now it will be like , http:localhost:5000/gateway/Orders => mapped to "http://ordersmicroservice.api:8080/api/Orders"
      ],


      "UpstreamHttpMethod": [ "Get", "Post", "Options" ],
      "UpStreamScheme": "http"



    }, // for get orfers , similarly for all the routes we need to do this
    {
      // POST METHOD ADD ORDER
      "UpstreamPathTemplate": "/gateway/Orders/AddOrder",
      "DownstreamPathTemplate": "/api/Orders/CreateOrders",
      "DownstreamHostAndPorts": [
        {
          "Host": "ordersmicroservice.api",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Post", "Options" ],
      "UpStreamScheme": "http"
    },
    {
      //GET ORDER BY ORDER ID
      "UpstreamPathTemplate": "/gateway/Orders/search/orderid/{orderId}",
      "DownstreamPathTemplate": "/api/Orders/GetOrderByCondition/{orderId}",
      "DownstreamHostAndPorts": [
        {
          "Host": "ordermicroservice.api",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Get" ],
      "UpStreamScheme": "http"
    },
    {
      // Get Orders by Product Id
      "UpstreamPathTemplate": "/gateway/Orders/search/productid/{productId}",
      "DownstreamPathTemplate": "/api/Orders/GetOrdersbyProductId/{productId}",
      "DownstreamHostAndPorts": [
        {
          "Host": "ordermicroservice.api",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Get" ],
      "UpStreamScheme": "http"
    },
    {
      //GET ORDERS BY ORDER DATAE
      "UpstreamPathTemplate": "/gateway/Orders/search/orderdate/{orderDate}",
      "DownstreamPathTemplate": "/api/Orders/GetOrdersByDate/{orderDate}",
      "DownstreamHostAndPorts": [
        {
          "Host": "ordermicroservice.api",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Get" ],
      "UpStreamScheme": "http"
    },
    {
      //UPDATE ORDERS BY ORDER DATAE
      "UpstreamPathTemplate": "/gateway/Orders/search/updateorder/{orderId}",
      "DownstreamPathTemplate": "/api/Orders/UpdateOrders/{orderId}",
      "DownstreamHostAndPorts": [
        {
          "Host": "ordermicroservice.api",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Put", "Options" ],
      "UpStreamScheme": "http"
    },
    {

      // DELETE ORDER
      "UpstreamPathTemplate": "/gateway/Orders/search/DeleteOrder/{orderId}",
      "DownstreamPathTemplate": "/api/Orders/DeleteOrder/{orderId}",
      "DownstreamHostAndPorts": [
        {
          "Host": "ordermicroservice.api",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Delete", "Options" ],
      "UpStreamScheme": "http"
    },
    //========================================================================================= PRODUCTS MICROSERVICE
    {
      // GET ALL Products
      "UpstreamPathTemplate": "/gateway/Products/GetAllProducts",
      "DownstreamPathTemplate": "/api/Product/GetAllProducts",
      "DownstreamHostAndPorts": [
        {
          "Host": "products-microservice",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Get", "Options" ],
      "UpStreamScheme": "http"
    },

    {
      // GET Product By id
      "UpstreamPathTemplate": "/gateway/Products/GetSingleProduct/{productId}",
      "DownstreamPathTemplate": "/api/Product/GetSingleProducts/{productId}",
      "DownstreamHostAndPorts": [
        {
          "Host": "products-microservice",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Get", "Options" ],
      "UpStreamScheme": "http",
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 3, // circuit breaker
        "DurationOfBreak": 100000,
        "TimeoutValue": 5000

      },
      "RetryOptions": {
        "RetryCount": 3,
        "RetryOnServerError": true


      },
      "RateLimitOptions": {
        "Limit": 3,
        "Period": "1m",
        "HttpStatusCode": 429,
        "EnableRateLimiting": true,
        "PeriodTimespan": 30 // after 30 seconds the rate limited is reset
        // sometimes , some clients are needed to bypass these rate limits 
        // they can be done using ClientWhitelist consist of arrays of clients who can bypass however,
        // they need to be identified so we use another option called  [ClientIdHeader] to specify the schema of header
      },
      "FileCacheOptions": {
        "TtlSeconds": 30,
        "Region": "Orders"
      }, // this will decrease the response time 
      
    },
    {
      // Create Product
      "UpstreamPathTemplate": "/gateway/Products/CreateProduct",
      "DownstreamPathTemplate": "/api/Product/CreateProduct",
      "DownstreamHostAndPorts": [
        {
          "Host": "products-microservice",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Post", "Options" ],
      "UpStreamScheme": "http"
    },
    {
      // Update Products
      "UpstreamPathTemplate": "/gateway/Products/UpdateProduct/{productId}",
      "DownstreamPathTemplate": "/api/Product/UpdateProduct/{productId}",
      "DownstreamHostAndPorts": [
        {
          "Host": "products-microservice",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Put", "Options" ],
      "UpStreamScheme": "http"
    },
    {
      // Delete Product
      "UpstreamPathTemplate": "/gateway/Products/DeleteProduct",
      "DownstreamPathTemplate": "/api/Product/DeleteProduct/{productId}",
      "DownstreamHostAndPorts": [
        {
          "Host": "products-microservice",
          "Port": 8080
        }
      ],
      "UpstreamHttpMethod": [ "Delete", "Options" ],
      "UpStreamScheme": "http"
    },
    // ========================================================================================= Users Microservice

    {
      // Login 
      "UpstreamPathTemplate": "/gateway/Users/Auth/Login",
      "DownstreamPathTemplate": "/api/Auth/Login",
      "DownstreamHostAndPorts": [
        {
          "Host": "users-microservice",
          "Port": 9090
        }
      ],
      "UpstreamHttpMethod": [ "Post", "Options" ],
      "UpStreamScheme": "http"
    },
    {
      // Register
      "UpstreamPathTemplate": "/gateway/Users/Auth/Register",
      "DownstreamPathTemplate": "/api/Auth/Register",
      "DownstreamHostAndPorts": [
        {
          "Host": "users-microservice",
          "Port": 9090
        }
      ],
      "UpstreamHttpMethod": [ "Post", "Options" ],
      "UpStreamScheme": "http"
    },
    {
      // Get User By Id
      "UpstreamPathTemplate": "/gateway/Users/GetUserById/{userId}",
      "DownstreamPathTemplate": "/api/Users/GetUserByID/{userId}",
      "DownstreamHostAndPorts": [
        {
          "Host": "users-microservice",
          "Port": 9090
        }
      ],
      "UpstreamHttpMethod": [ "Get" ],
      "UpStreamScheme": "http",
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 3,
        "DurationOfBreak": 30,
        "TimeoutValue": 5000
      },
      "RetryOptions": {
        "RetryCount": 3,
        "RetryOnServerError": true
      },
      "RateLimitOptions": {
        "Limit": 3,
        "Period": "1m",
        "HttpStatusCode": 429,
        "EnableRateLimiting": true,
        "PeriodTimespan": 30
      },
      "FileCacheOptions": {
        "TtlSeconds": 30,
        "Region": "Users"
      }
    },
    
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:4000"
  }
}
